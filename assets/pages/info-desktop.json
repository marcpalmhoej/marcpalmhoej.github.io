{"id": "J1780197151", "set_id": "root", "title": "Info Desktop", "purl": "info-desktop", "page_type": "page", "content": "<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\" />\n<title>Clickable Links</title>\n<link href=\"styles.css\" rel=\"stylesheet\" />\n\n<div class=\"brand\">Marc Palmhøj</div>\n\n<div class=\"glass\">\n    <a class=\"nav-link\" href=\"/\">\nWorks</a>\n    \n    <a class=\"nav-link\" href=\"/info\" rel=\"history\">Info</a>\n    <a class=\"nav-link\" href=\"https://instagram.com/marc_palmhoej/\" target=\"_blank\">Instagram</a>\n</div>\n\n<script>\ndocument.querySelectorAll('.nav-link').forEach(link => {\n    link.addEventListener('click', function() {\n        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));\n        this.classList.add('active');\n    });\n\n    // Optional: auto-highlight based on URL\n    if (link.href === window.location.href) {\n        link.classList.add('active');\n    }\n});\n</script>", "local_css": "[id=\"J1780197151\"] .page-layout {\n\talign-items: flex-start;\n\tmax-width: 24.5%;\n}\n\n[id=\"J1780197151\"].page {\n\tjustify-content: flex-end;\n\tmin-height: auto;\n}\n\n[id=\"J1780197151\"] .page-content {\n\tborder-style: solid;\n\tborder-color: rgba(0, 0, 0, 0);\n\ttext-align: left;\n\tpadding: 2rem;\n\tbackground-color: rgba(0, 0, 0, 0);\n\tpadding-top: 3.025rem;\n}\n\n.icons1:hover text-icon,\n.icons1:hover media-item {\n\tfilter: brightness(60%);\n}\n\n/* Global link reset */\na {\n\ttext-decoration: none;\n}\n\n/* Email link */\n.email-link {\n\ttext-decoration: none;\n\tcolor: #D9D9D9;\n}\n\n.email-link:hover {\n\ttext-decoration: underline;\n}\n\n/* Brand */\n.brand {\n\tfont-size: 1.55rem;\n\tcolor: white;\n\tfont-weight: 500;\n\tmargin-bottom: 5px;\n\tmargin-top: 5px;\n}\n\n/* 🔹 Navigation links (stacked vertically with animated underline) */\n.nav-link {\n\tposition: relative;\n\tdisplay: block;              /* ensures vertical stacking */\n\twidth: fit-content;          /* underline matches text width */\n\tfont-size: 1.35rem;\n    line-height: 1.3;   /* ← adjust here */\n\tcolor: #bbb;\n\ttext-decoration: none;\n\tmargin: 6px 0;\n\ttransition: color 0.2s ease;\n}\n\n/* Animated underline */\n.nav-link::after {\n\tcontent: \"\";\n\tposition: absolute;\n\tleft: 0;\n\tbottom: 1px;\n\twidth: 100%;\n\theight: 2px;\n\tbackground-color: white;\n\ttransform: scaleX(0);\n\ttransform-origin: left;\n\ttransition: transform 0.3s ease;\n}\n\n/* Hover state */\n.nav-link:hover {\n\tcolor: #eee;\n}\n\n.nav-link:hover::after {\n\ttransform: scaleX(1);\n}\n\n/* Active state */\n.nav-link.active {\n\tcolor: white;\n\tfont-weight: 600;\n}\n\n.nav-link.active::after {\n\ttransform: scaleX(1);\n}\n\n/* Icons */\n.icons1 {\n\tpadding-top: 10px;\n}\n\n.icons1 text-icon,\n.icons1 media-item {\n\tdisplay: block;\n\twidth: 2rem;\n\theight: 2rem;\n\tcolumn-gap: 25%;\n}\n\n/* Responsive */\n@media screen and (max-width: 600px) {\n\t.icons1 text-icon,\n\t.icons1 media-item {\n\t\twidth: 2.5rem;\n\t\theight: 2.5rem;\n\t\tcolumn-gap: 25%;\n\t}\n}", "display": true, "stack": false, "pin": true, "overlay": false, "password_enabled": false, "sort": 16, "index": null, "page_count": null, "page_design_options": null, "backdrops": {"activeBackdrop": "none"}, "pin_options": {"screen_visibility": "desktop", "position": "top", "overlay": true, "fixed": true, "adjust": false}, "overlay_options": {"closeOnClickout": true, "closeOnNavigate": true, "animateOnOpen": {"fade": false, "speed": 0, "slideAmount": 0, "slideDirection": "default", "wipeShape": "default", "easing": "linear", "scaleAmount": 0, "rotateAmount": 0}, "animateOnClose": {"fade": false, "speed": 0, "slideAmount": 0, "slideDirection": "default", "wipeShape": "default", "easing": "linear", "scaleAmount": 0, "rotateAmount": 0}, "openOnLoad": false}, "thumb_media_id": 37789065, "thumbnail": {"id": 37789065, "master_muid": 14993954, "name": "icon-park-solid_instagram.png", "display_name": null