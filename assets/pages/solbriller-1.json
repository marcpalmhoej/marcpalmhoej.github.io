{"id": "U0874584635", "set_id": "W3104458125", "title": "Solbriller", "purl": "solbriller-1", "page_type": "page", "content": "<column-set gutter=\"0.5rem\"><column-unit slot=\"0\"><gallery-slideshow class=\"move-down\" disable-scroll-animation=\"true\" pause-on-hover=\"true\" scale=\"100%\" style=\"margin-top: 0px\" transition-speed=\"1.5\" transition-type=\"scrub\"><media-item src=\"/assets/media/B1852925664366228201955320449570-Screenshot-2023-05-23-at-23.05.41-copy.png\" width=\"1090\" height=\"1356\" limit-by=\"width\" rotation=\"0\" scale=\"100\"></media-item><media-item src=\"/assets/media/H1831053023449418882142007773730-Solbriller-1.png\" width=\"864\" height=\"1080\" limit-by=\"width\" rotation=\"0\" scale=\"100\"></media-item><media-item src=\"/assets/media/U1852964139515105989062927108642-laser-2.jpg\" width=\"1080\" height=\"1350\" limit-by=\"width\" rotation=\"0\" scale=\"100\"></media-item></gallery-slideshow></column-unit><column-unit slot=\"1\">\n<h2>\n<a class=\"project-title\" href=\"gaze-spacial\" rel=\"history\">Fine Chaos</a><span class=\"icons2\">\n</span>\n  </h2><p class=\"descrip-com\">\nProject done in C4D &#x26; Redshift.\n</p> <div class=\"icons\"><div id=\"moreText\" style=\"display: none;\"> <p class=\"project-text\">Fine Chaos commissioned me recreate their two new sunglasses as part of their new collection, and wanted me to visualize how the sunglasses could be vizualized in a 3D environment and space.</p>\n<p class=\"project-text\">I modelled both sunglasses from the buttom and learned a lot about everything from modelling to UV mapping. This process has not only enriched my modeling skills but also deepened my understanding of how to conceptually capture a product like sunglasses in a captivating way.</p> <div class=\"details\">Year: 2024<br />\nClient: Fine Chaos<br />\n</div> </div>\n<span class=\"view-full-project\" onclick=\"toggleText(this)\"></span>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    let moreTextElements = document.querySelectorAll(\"#moreText\");\n\n    moreTextElements.forEach(function(moreText) {\n        let button = moreText.nextElementSibling;\n\n        // Use computed style to check actual visibility\n        let computedDisplay = window.getComputedStyle(moreText).display;\n\n        if (computedDisplay === \"none\") {\n            button.innerHTML = 'Read More ↓';\n        } else {\n            button.innerHTML = 'Read Less ↑';\n        }\n    });\n});\n\nfunction toggleText(button) {\n    let moreText = button.previousElementSibling;\n\n    let computedDisplay = window.getComputedStyle(moreText).display;\n\n    if (computedDisplay === \"none\") {\n        moreText.style.display = \"inline\";\n        button.innerHTML = 'Read Less ↑';\n    } else {\n        moreText.style.display = \"none\";\n        button.innerHTML = 'Read More ↓';\n    }\n}\n</script></div></column-unit></column-set><br />\n<br />", "local_css": "[id=\"U0874584635\"] bodycopy {\n}\n\n.buttons{\n\tcolor: #000000; \n}\n\n.buttons:hover{\n   filter: brightness(60%);\n}\n\n.page-content {\n  padding-top: 3.23rem;\n}\n.buttons {\n  background: transparent;\n  color: #ffffff;\n  border: 1px solid #ffffff;\n  text-decoration: none;\n  display: inline-block;\n}\n\n\n[id=\"U0874584635\"].page {\n\tbackground-color: #000000;\n}\n\n.gallery-slideshow {\n\tpadding-top: 100px;\n}\n.descrip {\n    font-size: 19px;\n    line-height: 1.4;\n}", "display": true, "stack": false, "pin": false, "overlay": false, "password_enabled": false, "sort": 25, "index": 4, "page_count": null, "page_design_options": null, "backdrops": {"activeBackdrop": "none"}, "pin_options": {}, "overlay_options": {}, "thumb_media_id": 30084308, "thumbnail": {"id": 30084308, "master_muid": 14065331, "name": "horizontal_dark.svg", "display_name": null, "hash": "Y1609344672387048371000003960499", "width": 3001, "height": 1876, "file_size": 217, "file_type": "svg", "mime_type": "image/svg+xml", "is_image": true, "i